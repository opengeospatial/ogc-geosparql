cs:
    a skos:ConceptScheme ;
    dcterms:source <http://www.opengis.net/doc/geosparql/1.1> ;
    rdfs:seeAlso <http://www.opengis.net/doc/geosparql/1.1> ;
    owl:versionIRI geof:1.1 ;
    skos:definition "All of the RCC8 Topological Functions"@en ;
    skos:hasTopConcept
        geof:rcc8dc ,
        geof:rcc8ec ,
        geof:rcc8eq ,
        geof:rcc8ntpp ,
        geof:rcc8ntppi ,
        geof:rcc8po ,
        geof:rcc8tpp ,
        geof:rcc8tppi ;
    skos:historyNote "Defined since GeoSPARQL 1.0" ;
    skos:prefLabel "RCC8 Topological Functions"@en ;
