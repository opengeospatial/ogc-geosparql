PREFIX cs: <http://www.opengis.net/def/non-ogc-standards>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://paulbourke.net/dataformats/ply/>
    a
        dcterms:Standard ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    rdfs:topConceptOf cs: ;
    skos:definition "PLY, also called the Stanford Triangle Format, stores a graphical object as vertices, polygonal faces and other elements with associated properties such as colour and surface normals. It supports ASCII and binary encodings for exchanging polygon models."@en ;
    skos:prefLabel "PLY - Polygon File Format"@en ;
    schema:citation "https://paulbourke.net/dataformats/ply/"^^xsd:anyURI ;
.

<https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html>
    a
        dcterms:Standard ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    rdfs:topConceptOf cs: ;
    skos:definition "glTF 2.0 specifies a portable 3D asset format designed for compact delivery and fast loading by graphics applications. It combines a JSON scene description with binary resources for geometry, animation and other scene data."@en ;
    skos:prefLabel "glTF 2.0 Specification"@en ;
    schema:citation "https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html"^^xsd:anyURI ;
.

<https://www.rfc-editor.org/info/rfc7946/>
    a
        dcterms:Standard ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    rdfs:topConceptOf cs: ;
    skos:definition "GeoJSON specifies a JSON-based interchange format for geographic features, including their properties and spatial extents. It uses the WGS84 geographic coordinate reference system with coordinates expressed in decimal degrees."@en ;
    skos:prefLabel "RFC 7946: The GeoJSON Format"@en ;
    schema:citation "https://www.rfc-editor.org/info/rfc7946/"^^xsd:anyURI ;
.

<https://www.topografix.com/GPX/1/1/>
    a
        dcterms:Standard ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    rdfs:topConceptOf cs: ;
    skos:definition "GPX 1.1 defines an XML schema for documents containing metadata, waypoints, routes and tracks, with an extensions section for additional elements. Coordinates use the WGS84 datum, and measurements use metric units."@en ;
    skos:prefLabel "GPX 1.1 Schema Documentation"@en ;
    schema:citation "https://www.topografix.com/GPX/1/1/"^^xsd:anyURI ;
.

<https://www.web3d.org/x3d4>
    a
        dcterms:Standard ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    rdfs:topConceptOf cs: ;
    skos:definition "X3D version 4 upgrades the Extensible 3D graphics standard to support publishing interactive 3D content on the Web. It integrates support for HTML5, glTF physically based rendering, Web Audio, MIDI 2.0 and Humanoid Animation 2.0."@en ;
    skos:prefLabel "X3D Version 4.0 Standard Overview"@en ;
    schema:citation "https://www.web3d.org/x3d4"^^xsd:anyURI ;
.

cs:
    a skos:ConceptScheme ;
    skos:definition "Non-OGC standards referred to by GeoSPARQL semantic resources"@en ;
    skos:hasTopConcept
        <https://paulbourke.net/dataformats/ply/> ,
        <https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html> ,
        <https://www.rfc-editor.org/info/rfc7946/> ,
        <https://www.topografix.com/GPX/1/1/> ,
        <https://www.web3d.org/x3d4> ;
    skos:historyNote "2025-11: This vocabulary was created to support the OGC GeoSPARQL Geometry Datatypes Register"@en ;
    skos:prefLabel "Non-OGC Standards for reference in GeoSPARQL" ;
    schema:copyrightNotice "(c) 2023 Open Geospatial Consortium" ;
    schema:creator <https://defs.opengis.net/org/geosparql-swg> ;
    schema:dateCreated "2026-11-12"^^xsd:date ;
    schema:dateModified "2026-11-12"^^xsd:date ;
    schema:license <http://purl.org/NET/rdflicense/APACHE2.0> ;
    schema:publisher <https://defs.opengis.net/org/ogc> ;
.
