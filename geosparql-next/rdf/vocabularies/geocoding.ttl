PREFIX : <http://www.opengis.net/ont/geocode/>
PREFIX cs: <http://www.opengis.net/def/geocodes>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:C-Squares
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Concise Spatial QUery And REpresentation System" ;
    skos:broader :GeoCode ;
    skos:definition "C-Squares is a system of spatially unique, location-based identifiers for areas on earth represented as cells from the Discrete Global Grid." ;
    skos:inScheme cs: ;
    skos:prefLabel "C-Squares"@en ;
    schema:citation "http://www.marine.csiro.au/csquares/"^^xsd:anyURI ;
.

:CLLICode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Common Language Location Identifier Code"@en ;
    skos:broader :GeoCode ;
    skos:definition "A location identifier code used within the North American telecommunications industry to specify the location and function to telecommunications equipment" ;
    skos:inScheme cs: ;
    skos:prefLabel "CLLI Code"@en ;
.

:EirCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :PostalCode ;
    skos:definition "Postal Code of Ireland"@en ;
    skos:example "A65 F4E2" ;
    skos:inScheme cs: ;
    skos:prefLabel "EirCode"@en ;
.

:FIFACountryCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    rdfs:seeAlso "https://www.rsssf.org/miscellaneous/fifa-codes.html"^^xsd:anyURI ;
    skos:broader :CountryCode ;
    skos:definition "The FIFA country code is a three-letter code to identify its member and non-member countries" ;
    skos:example "ENG for England" ;
    skos:inScheme cs: ;
    skos:prefLabel "FIFA Country Code"@en ;
.

:GSSCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :AdministrativeCode ;
    skos:definition "A GSS Code is a nine-character geocode maintained by the United Kingdom's Office for National Statistics to represent geographical areas of the UK" ;
    skos:example "E09000011 for Royal Borough for Greenwich" ;
    skos:inScheme cs: ;
    skos:prefLabel "GSS Code"@en ;
.

:GeoHash-36
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoHashCode ;
    skos:definition "GeoHash-36 is an open source compression algorithm for world coordinate data" ;
    skos:example "9LVB4BH89g-m for Statue of Liberty in New York, USA" ;
    skos:inScheme cs: ;
    skos:prefLabel "GeoHash-36"@en ;
    schema:citation "https://web.archive.org/web/20121227195936/http://www.openpostcode.org/other-codes/geohash-36"^^xsd:anyURI ;
.

:GeoRef
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "World Geographic Reference System"@en ;
    skos:broader :GeoCode ;
    skos:definition "World Geographic Reference System"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "GeoRef"@en ;
    schema:citation "https://earth-info.nga.mil/GandG/coordsys/grids/georef.pdf"^^xsd:anyURI ;
.

:IANACountryCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :CountryCode ;
    skos:definition "The country codes which comprise the top level domain generally used by or reserved for a country" ;
    skos:example "NL for the Netherlands" ;
    skos:inScheme cs: ;
    skos:prefLabel "IANA Country Code"@en ;
.

:IATAAirportCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :AirportCode ;
    skos:definition "A three-letter code issued by the International Air Transport Association (IATA) to identify airports and metropolitan areas on Earth." ;
    skos:example "FRA for Frankfurt International Airport, Germany" ;
    skos:inScheme cs: ;
    skos:prefLabel "IATA Airport Code"@en ;
.

:ICAOAirportCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :AirportCode ;
    skos:definition "A four-letter code used to identify aerodromes on Earth." ;
    skos:example "EDDF for Frankfurt International Airport, Germany" ;
    skos:inScheme cs: ;
    skos:prefLabel "ICAO Airport Code"@en ;
.

:IOCCountryCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :CountryCode ;
    skos:definition "International Olympic Committee country codes identifying countries associated with the Olympic Games" ;
    skos:example "AUS for Australia" ;
    skos:inScheme cs: ;
    skos:prefLabel "IOC Country Code"@en ;
.

:ITU-RCountryCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader
        :CountryCode ,
        :TelephoneCode ;
    skos:definition "ITU-R Country Code"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ITU-R Country Code"@en ;
.

:ITU-TCountryCallingCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :TelephoneCode ;
    skos:definition "Country calling codes are telephone number prefixes for reaching telephone subscribers in foreign countries or territories" ;
    skos:inScheme cs: ;
    skos:prefLabel "ITU-T Country Calling Code"@en ;
.

:ITU-TMobileCallingCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :TelephoneCode ;
    skos:definition "ITU-T Mobile Calling Code"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ITU-T Mobile Calling Code"@en ;
.

:MGRS
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Military Grid Reference System"@en ;
    skos:broader :GeoCode ;
    skos:definition "The geocoordinate standard derived from the UTM grid used by NATO militaries to located points on Earth." ;
    skos:inScheme cs: ;
    skos:prefLabel "MGRS"@en ;
.

:MaidenheadLocatorSystem
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "IARU Locator"@en ,
        "QTH Locator"@en ;
    skos:broader :AmateurRadio ;
    skos:definition "Geocode System used by amateur radio operators"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Maidenhead Locator System"@en ;
.

:Mapcode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoCode ;
    skos:definition "A mapcode is an open source geocode system consisting of two groups of letters and digits to identify places on earth" ;
    skos:example "France 4J.Q2 for Eiffel Tower" ;
    skos:inScheme cs: ;
    skos:prefLabel "Mapcode"@en ;
    schema:citation "https://www.mapcode.com"^^xsd:anyURI ;
.

:MarsdenSquare
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoCode ;
    skos:definition "A system that divides a word map into a latitude-longitude grid" ;
    skos:inScheme cs: ;
    skos:prefLabel "Marsden Square"@en ;
.

:MeshBlockCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :AdministrativeCode ;
    skos:definition "A Mesh Block Code is an 11-digit code indicating a Mesh Block, the smallest geographic areas defined by the Australian Bureau of Statistics for the Australian census. It comprises a State and Territory identifier (1 digit), and a Mesh Block identifier (10 digits)." ;
    skos:example "60032860000 for Mesh Block 0032860000 in Tasmania" ;
    skos:inScheme cs: ;
    skos:prefLabel "Mesh Block Code"@en ;
.

:NaturalAddressCode
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoCode ;
    skos:definition "A geocode to encode an address" ;
    skos:inScheme cs: ;
    skos:prefLabel "Natural Address Code"@en ;
.

:NaturalAreaCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Universal Address"@en ;
    skos:broader :GeoCode ;
    skos:definition "A proprietary geocode system for identifying areas anywhere on or in orbit around Earth." ;
    skos:inScheme cs: ;
    skos:prefLabel "Natural Area Code"@en ;
    schema:citation "http://www.nacgeo.com"^^xsd:anyURI ;
.

:OpenLocationCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Plus Code"@en ;
    skos:broader :GeoCode ;
    skos:definition "The Open Location Code is a geocode based on a system of regular grids. It may be used to identify any location on Earth." ;
    skos:example "6PH57VP3+PR for Merlion Park, Singapore" ;
    skos:inScheme cs: ;
    skos:prefLabel "Open Location Code"@en ;
    schema:citation "https://maps.google.com/pluscodes/"^^xsd:anyURI ;
.

:PlaceCode
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "P-Code"@en ;
    skos:broader :GeoCode ;
    skos:definition "A Geocode mostly used by emergency response teams"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Place Code"@en ;
.

:PostalndexNumber
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :PostalCode ;
    skos:definition "A six-digit code used by India Post" ;
    skos:example "110040 for Bankner, North West Delhi" ;
    skos:inScheme cs: ;
    skos:prefLabel "Postal Index Number"@en ;
.

:QRALocator
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "QTH Locator"@en ;
    skos:broader :AmateurRadio ;
    skos:definition "Obsolete geocoding system used by amateur radio operators in Europe"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "QRA Locator"@en ;
.

:UKPostCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :PostalCode ;
    skos:definition "A postcode used to identify areas in the United Kingdom and its overseas territories" ;
    skos:example "ASCN 1ZZ for Ascension Island" ;
    skos:inScheme cs: ;
    skos:prefLabel "UK PostCode"@en ;
.

:UN-LOCODE
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "United Nations Code for Trade and Transport Locations"@en ;
    skos:broader :GeoCode ;
    skos:definition "A geographic encoding scheme developed by the United Nations Economic Commission for Europe" ;
    skos:inScheme cs: ;
    skos:prefLabel "UN/LOCODE"@en ;
    schema:citation "https://unece.org/trade/uncefact/unlocode"^^xsd:anyURI ;
.

:WMOSquare
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoCode ;
    skos:definition "World Meteorological Organisation Square"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "WMO Square"@en ;
    schema:citation "https://www.nodc.noaa.gov/OC5/WOD05/data05geo.html"^^xsd:anyURI ;
.

:What3Words
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoCode ;
    skos:definition "What3Words is a proprietary Geocoding System by What3Words Limited that can be used to identify any  location on the surface of Earth within 3 metres." ;
    skos:example "///slurs.this.shark for Downing Street 10 in London" ;
    skos:prefLabel "What3Words"@en ;
.

:ZIPCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :PostalCode ;
    skos:definition "Postal Code of the USA"@en ;
    skos:example "20521-9000 for Washington DC" ;
    skos:inScheme cs: ;
    skos:prefLabel "ZIP Code"@en ;
.

:GeoHashCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoCode ;
    skos:definition "A Geocode following the GeoHash encoding"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "GeoHash Code"@en ;
    schema:citation "http://geohash.org"^^xsd:anyURI ;
.

:AirportCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoCode ;
    skos:definition "A code used to identify the geolocation of an airport" ;
    skos:inScheme cs: ;
    skos:prefLabel "Airport Code"@en ;
.

:AmateurRadio
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoCode ;
    skos:definition "Geocodes used by operators in the amateur radio community"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Amateur radio"@en ;
.

:TelephoneCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoCode ;
    skos:definition "A code used to identify telephones by location." ;
    skos:inScheme cs: ;
    skos:prefLabel "Telephone Code"@en ;
.

:AdministrativeCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :GeoCode ;
    skos:definition "Administrative Code"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Administrative Code"@en ;
.

:CountryCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :AdministrativeCode ;
    skos:definition "A country code is a code to identify countries and dependent areas"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Country Code"@en ;
.

:PostalCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :AdministrativeCode ;
    skos:definition "A postal code is a code which is included in a postal address for the purpose of sorting mail"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Postal Code"@en ;
.

:GeoCode
    a
        rdfs:Datatype ,
        skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A code that represents a geographic entity"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "GeoCode"@en ;
    skos:topConceptOf cs: ;
.

cs:
    a skos:ConceptScheme ;
    skos:definition "A vocabulary to define Geocoding systems within OGC"@en ;
    skos:hasTopConcept :GeoCode ;
    skos:prefLabel "Geocoding Vocabulary"@en ;
