    a fno:Parameter ;
    skos:prefLabel "geom1"@en ;
    fno:required true ;
    fno:type
        geo:dggsLiteral ,
        geo:geoJSONLiteral ,
        geo:gmlLiteral ,
        geo:kmlLiteral ,
        geo:wktLiteral ;
.

