    a owl:Class ;
    rdfs:subClassOf
        obo:BFO_0000031 ,
        locn:Geometry ,
        schema:GeoShape ,
        cco:ont00000853 ;
.

geo:Feature
    a owl:Class ;
    rdfs:subClassOf
        dcterms:Location ,
        prov:Location ,
        gn:Class ;
    owl:equivalentClass 
        [
            a owl:Class ;
            owl:unionOf (
                obo:BFO_0000004
                obo:BFO_0000015
                obo:BFO_0000035
            ) ;
        ] ,
        as:Place ;
.
