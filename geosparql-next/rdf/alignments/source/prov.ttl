@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
PREFIX prov: <http://www.w3.org/ns/prov#>

geo:SpatialObjectCollection rdfs:subClassOf prov:Collection .
geo:SpatialObject rdfs:subClassOf prov:Entity .
geo:Feature rdfs:subClassOf prov:Location .