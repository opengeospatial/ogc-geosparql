PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX schema: <https://schema.org/>

<http://www.opengis.net/ont/geosparql-alignments>
    a owl:Ontology ;
    schema:description "Semantic alignments between GeoSPARQL Next and 17 other ontologies." ;
    schema:name "GeoSPARQL Alignments Ontology" ;
    schema:version "Next" ;
.
