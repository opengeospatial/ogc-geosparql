PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>

schema:GeoCoordinates
    rdfs:subClassOf geo:Geometry ;
.

schema:GeospatialGeometry
    owl:equivalentClass geo:SpatialObject ;
.

schema:Landform
    rdfs:subClassOf geo:Feature ;
.

schema:geo
    rdfs:subPropertyOf geo:hasGeometry ;
.

schema:geoCoveredBy
    owl:equivalentProperty geo:ehCoveredBy ;
.

schema:geoCovers
    owl:equivalentProperty geo:ehCovers ;
.

schema:geoCrosses
    owl:equivalentProperty geo:sfCrosses ;
.

schema:geoDisjoint
    owl:equivalentProperty geo:sfDisjoint ;
.

schema:geoEquals
    owl:equivalentProperty geo:sfEquals ;
.

schema:geoIntersects
    owl:equivalentProperty geo:sfIntersects ;
.

schema:geoOverlaps
    owl:equivalentProperty geo:sfOverlaps ;
.

schema:geoTouches
    owl:equivalentProperty geo:sfTouches ;
.

schema:geoWithin
    owl:equivalentProperty geo:sfWithin ;
.

geo:Geometry
    rdfs:subClassOf schema:GeoShape ;
.
