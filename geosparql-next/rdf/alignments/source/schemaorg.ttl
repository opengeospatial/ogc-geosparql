@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .
@prefix sf: <http://www.opengis.net/ont/sf#> .

geo:Geometry rdfs:subClassOf schema:GeoShape .
schema:GeospatialGeometry owl:equivalentClass geo:SpatialObject .
schema:GeoCoordinates rdfs:subClassOf geo:Geometry .
schema:geo rdfs:subPropertyOf geo:hasGeometry .
schema:geoCoveredBy owl:equivalentProperty geo:ehCoveredBy .
schema:geoCovers owl:equivalentProperty geo:ehCovers .
schema:geoCrosses owl:equivalentProperty geo:sfCrosses .
schema:geoDisjoint owl:equivalentProperty geo:sfDisjoint .
schema:geoEquals owl:equivalentProperty geo:sfEquals .
schema:geoIntersects owl:equivalentProperty geo:sfIntersects .
schema:geoOverlaps owl:equivalentProperty geo:sfOverlaps .
schema:geoTouches owl:equivalentProperty geo:sfTouches .
schema:geoWithin owl:equivalentProperty geo:sfWithin .
schema:Landform rdfs:subClassOf geo:Feature .
