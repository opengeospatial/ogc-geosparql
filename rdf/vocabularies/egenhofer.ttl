cs:
    a skos:ConceptScheme ;
    dcterms:source <http://www.opengis.net/doc/geosparql/1.1> ;
    rdfs:seeAlso <http://www.opengis.net/doc/geosparql/1.1> ;
    owl:versionIRI geof:1.1 ;
    skos:definition "All Egenhofer Topological Functions"@en ;
    skos:hasTopConcept
        geof:ehContains ,
        geof:ehCoveredBy ,
        geof:ehCovers ,
        geof:ehDisjoint ,
        geof:ehEquals ,
        geof:ehInside ,
        geof:ehMeet ,
        geof:ehOverlap ;
    skos:historyNote "Defined since GeoSPARQL 1.0" ;
    skos:prefLabel "Egenhofer Topological Functions"@en ;
