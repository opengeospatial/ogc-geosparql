    rdfs:seeAlso <http://www.opengis.net/doc/geosparql/1.1> ;
    skos:definition """A query function that returns true if the input geometries are disjoint.

DE-9IM: FF*FF****"""@en ;
    skos:inScheme cs: ;
    skos:prefLabel "disjoint"@en ;
    fno:expects (
        geof:ehDisjoint_param1
