PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX mrr: <https://prez.dev/ManifestResourceRoles/>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX schema: <https://schema.org/>

[]    a prez:Manifest ;
    prof:hasResource 
        [
            prof:hasArtifact "alignments/alignments.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:name "GeoSPARQL Alignments" ;
        ] ,
        [
            prof:hasArtifact "_background/*.ttl" ;
            prof:hasRole mrr:IncompleteCatalogueAndResourceLabels ;
            schema:name "Labels and Agent information" ;
        ] ,
        [
            prof:hasArtifact "validators/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:name "GeoSPARQL Validators" ;
        ] ,
        [
            dcterms:conformsTo <https://linked.data.gov.au/def/vocpub/validator> ;
            prof:hasArtifact "vocabularies/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:name "GeoSPARQL Vocabularies" ;
        ] ,
        [
            prof:hasArtifact "profile.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:name "GeoSPARQL Profile" ;
        ] ,
        [
            prof:hasArtifact "catalogue.ttl" ;
            prof:hasRole mrr:CatalogueData ;
            schema:name "GeoSPARQL Catalogue" ;
        ] ,
        [
            prof:hasArtifact "ontologies/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:name "GeoSPARQL Ontologies" ;
        ] ;
.
