PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vann: <http://purl.org/vocab/vann/>

<http://purl.obolibrary.org/obo/BFO_0000004>
    schema:description "b is an independent continuant =Def b is a continuant which is such that there is no c such that b s-depends on c and no c such that b g-depends on c"@en ;
    schema:name "independent continuant"@en ;
.

<http://purl.obolibrary.org/obo/BFO_0000006>
    schema:description "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time"@en ;
    schema:name "spatial region"@en ;
.

<http://purl.obolibrary.org/obo/BFO_0000029>
    schema:description "(Elucidation) b is a site means: b is a three-dimensional immaterial entity whose boundaries either (1) (partially or wholly) coincide with the boundaries of one or more material entities or (2) have locations determined in relation to some material entity"@en ;
    schema:name "site"@en ;
.

<http://purl.obolibrary.org/obo/BFO_0000040>
    schema:description "(Elucidation) A material entity is an independent continuant that at all times at which it exists has some portion of matter as continuant part"@en ;
    schema:name "material entity"@en ;
.

<http://purl.obolibrary.org/obo/BFO_0000066>
    schema:description "b occurs in c =Def b is a process or a process boundary and c is a material entity or immaterial entity & there exists a spatiotemporal region r and b occupies spatiotemporal region r & for all t, if b exists at t then c exists at t & there exist spatial regions s and s' where b spatially projects onto s at t & c occupies spatial region s' at t & s is a continuant part of s' at t"@en ;
    schema:name "occurs in"@en ;
.

<http://purl.obolibrary.org/obo/BFO_0000082>
    schema:description "b located in c at all times =Def for all times t, b exists at t implies (b and c are independent continuants and not spatial regions, and the spatial region which b occupies at t is a (proper or improper) continuant part of the spatial region which c occupies at t)"@en ;
    schema:name "located in at all times"@en ;
.

<http://purl.obolibrary.org/obo/BFO_0000171>
    schema:description "b located in c at some time =Def for some time t (b and c are independent continuants and not spatial regions, and the spatial region which b occupies at t is a (proper or improper) continuant part of the spatial region which c occupies at t)"@en ;
    schema:name "located in at some time"@en ;
.

<http://purl.obolibrary.org/obo/BFO_0000210>
    schema:description "an independent continuant c that is not a spatial region occupies spatial region r at some time =Def for some time t (every continuant part of c occupies some continuant part of r at t and no continuant part of c occupies any spatial region that is not a continuant part of r at t)"@en ;
    schema:name "occupies spatial region at some time"@en ;
.

<http://purl.obolibrary.org/obo/BFO_0000211>
    schema:description "an independent continuant c that is not a spatial region occupies spatial region r at all times =Def for all times t, b exists at t implies (every continuant part of c occupies some continuant part of r at t and no continuant part of c occupies any spatial region that is not a continuant part of r at t)"@en ;
    schema:name "occupies spatial region at all times"@en ;
.

<http://purl.obolibrary.org/obo/BFO_0000216>
    schema:description "b spatially projects onto c at some time =Def for some time t (b is a spatiotemporal region and c is a spatial region and c is the spatial extent of b at t)"@en ;
    schema:name "spatially projects onto at some time"@en ;
.

dcterms:Location
    schema:description "A spatial region or named place." ;
    schema:name "Location" ;
.

dcterms:conformsTo
    schema:description "An established standard to which the described resource conforms." ;
    schema:name "Conforms To" ;
.

dcterms:contributor
    schema:description "An entity responsible for making contributions to the resource." ;
    schema:name "Contributor" ;
.

dcterms:creator
    schema:description "An entity responsible for making the resource." ;
    schema:name "Creator" ;
.

dcterms:date
    schema:description "A point or period of time associated with an event in the lifecycle of the resource." ;
    schema:name "Date" ;
.

dcterms:format
    schema:description "The file format, physical medium, or dimensions of the resource." ;
    schema:name "Format" ;
.

dcterms:replaces
    schema:description "A related resource that is supplanted, displaced, or superseded by the described resource." ;
    schema:name "Replaces" ;
.

dcterms:requires
    schema:description "A related resource that is required by the described resource to support its function, delivery, or coherence." ;
    schema:name "Requires" ;
.

dcterms:source
    schema:description "A related resource from which the described resource is derived." ;
    schema:name "Source" ;
.

dcterms:spatial
    schema:description "Spatial characteristics of the resource." ;
    schema:name "Spatial Coverage" ;
.

vann:preferredNamespacePrefix
    schema:description "The preferred namespace prefix to use when using terms from this vocabulary in an XML document." ;
    schema:name "Preferred Namespace Prefix" ;
.

vann:preferredNamespaceUri
    schema:description "The preferred namespace URI to use when using terms from this vocabulary in an XML document." ;
    schema:name "Preferred Namespace Uri" ;
.

rdf:Property
    schema:description "The class of RDF properties." ;
    schema:name "Property" ;
.

rdf:first
    schema:description "The first item in the subject RDF list." ;
    schema:name "first" ;
.

()
    schema:description "The empty list, with no items in it. If the rest of a list is nil then the list has no more items in it." ;
    schema:name "nil" ;
.

rdf:rest
    schema:description "The rest of the subject RDF list after the first item." ;
    schema:name "rest" ;
.

rdfs:Literal
    schema:description "The class of literal values, eg. textual strings and integer" ;
    schema:name "Literal" ;
.

owl:Class
    schema:description "The class of OWL classes." ;
    schema:name "Class" ;
.

owl:DatatypeProperty
    schema:description "The class of data properties." ;
    schema:name "DatatypeProperty" ;
.

owl:ObjectProperty
    schema:description "The class of object properties." ;
    schema:name "ObjectProperty" ;
.

owl:Ontology
    schema:description "The class of ontologies." ;
    schema:name "Ontology" ;
.

owl:Restriction
    schema:description "The class of property restrictions." ;
    schema:name "Restriction" ;
.

owl:allValuesFrom
    schema:description "The property that determines the class that a universal property restriction refers to." ;
    schema:name "allValuesFrom" ;
.

owl:cardinality
    schema:description "The property that determines the cardinality of an exact cardinality restriction." ;
    schema:name "cardinality" ;
.

owl:disjointWith
    schema:description "The property that determines that two given classes are disjoint." ;
    schema:name "disjointWith" ;
.

owl:equivalentClass
    schema:description "The property that determines that two given classes are equivalent, and that is used to specify datatype definitions." ;
    schema:name "equivalentClass" ;
.

owl:equivalentProperty
    schema:description "The property that determines that two given properties are equivalent." ;
    schema:name "equivalentProperty" ;
.

owl:hasValue
    schema:description "The property that determines the individual that a has-value restriction refers to." ;
    schema:name "hasValue" ;
.

owl:onProperty
    schema:description "The property that determines the property that a property restriction refers to." ;
    schema:name "onProperty" ;
.

owl:propertyChainAxiom
    schema:description "The property that determines the n-tuple of properties that build a sub property chain of a given property." ;
    schema:name "propertyChainAxiom" ;
.

owl:versionIRI
    schema:description "The property that identifies the version IRI of an ontology." ;
    schema:name "versionIRI" ;
.

owl:versionInfo
    schema:description "The annotation property that provides version information for an ontology or another OWL construct." ;
    schema:name "versionInfo" ;
.

skos:Collection
    schema:description "A meaningful collection of concepts." ;
    schema:name "Collection" ;
.

skos:Concept
    schema:description "An idea or notion; a unit of thought." ;
    schema:name "Concept" ;
.

skos:ConceptScheme
    schema:description "A set of concepts, optionally including statements about semantic relationships between those concepts." ;
    schema:name "Concept Scheme" ;
.

skos:altLabel
    schema:description
        "An alternative lexical label for a resource." ,
        "The range of skos:altLabel is the class of RDF plain literals." ,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties." ;
    schema:name "alternative label" ;
.

skos:definition
    schema:description "A statement or formal explanation of the meaning of a concept." ;
    schema:name "definition" ;
.

skos:exactMatch
    schema:description
        "skos:exactMatch is disjoint with each of the properties skos:broadMatch and skos:relatedMatch." ,
        "skos:exactMatch is used to link two concepts, indicating a high degree of confidence that the concepts can be used interchangeably across a wide range of information retrieval applications. skos:exactMatch is a transitive property, and is a sub-property of skos:closeMatch." ;
    schema:name "has exact match" ;
.

skos:example
    schema:description "An example of the use of a concept." ;
    schema:name "example" ;
.

skos:hasTopConcept
    schema:description "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies." ;
    schema:name "has top concept" ;
.

skos:historyNote
    schema:description "A note about the past state/use/meaning of a concept." ;
    schema:name "history note" ;
.

skos:inScheme
    schema:description "Relates a resource (for example a concept) to a concept scheme in which it is included." ;
    schema:name "is in scheme" ;
.

skos:member
    schema:description "Relates a collection to one of its members." ;
    schema:name "has member" ;
.

skos:narrower
    schema:description "Relates a concept to a concept that is more specific in meaning." ;
    schema:name "has narrower" ;
.

skos:note
    schema:description "A general note, for any purpose." ;
    schema:name "note" ;
.

skos:prefLabel
    schema:description "The preferred lexical label for a resource, in a given language." ;
    schema:name "preferred label" ;
.

skos:scopeNote
    schema:description "A note that helps to clarify the meaning and/or the use of a concept." ;
    schema:name "scope note" ;
.

skos:topConceptOf
    schema:description "Relates a concept to the concept scheme that it is a top level concept of." ;
    schema:name "is top concept in scheme" ;
.

dcat:Catalog
    schema:description "A curated collection of metadata about resources (e.g., datasets and data services in the context of a data catalog)." ;
    schema:name "Catalog" ;
.

prof:Profile
    schema:description """A specification that constrains, extends, combines, or provides guidance or explanation about the usage of other specifications.

This definition includes what are often called "application profiles", "metadata application profiles", or "metadata profiles".""" ;
    schema:name "Profile" ;
.

prof:ResourceDescriptor
    schema:description "A description of a resource that defines an aspect - a particular part, feature or role - of a Profile" ;
    schema:name "Resource Descriptor" ;
.

prof:hasArtifact
    schema:description "The URL of a downloadable file with particulars such as its format and role indicated by the Resource Descriptor" ;
    schema:name "has artifact" ;
.

prof:hasResource
    schema:description "A resource which describes the nature of an artifact and the role it plays in relation to the Profile" ;
    schema:name "has resource" ;
.

prof:hasRole
    schema:description "The function of an artifact described by a Resource Descriptor, such as specification, guidance etc." ;
    schema:name "has role" ;
.

sh:Literal
    schema:description "The node kind of all literals."@en ;
    schema:name "Literal"@en ;
.

sh:NodeShape
    schema:description "A node shape is a shape that specifies constraint that need to be met with respect to focus nodes."@en ;
    schema:name "Node shape"@en ;
.

sh:PropertyShape
    schema:description "A property shape is a shape that specifies constraints on the values of a focus node for a given property or path."@en ;
    schema:name "Property shape"@en ;
.

sh:alternativePath
    schema:description "The (single) value of this property must be a list of path elements, representing the elements of alternative paths."@en ;
    schema:name "alternative path"@en ;
.

sh:datatype
    schema:description "Specifies an RDF datatype that all value nodes must have."@en ;
    schema:name "datatype"@en ;
.

sh:deactivated
    schema:description "If set to true then all nodes conform to this."@en ;
    schema:name "deactivated"@en ;
.

sh:flags
    schema:description "An optional flag to be used with regular expression pattern matching."@en ;
    schema:name "flags"@en ;
.

sh:maxCount
    schema:description "Specifies the maximum number of values in the set of value nodes."@en ;
    schema:name "max count"@en ;
.

sh:message
    schema:description "A human-readable message (possibly with placeholders for variables) explaining the cause of the result."@en ;
    schema:name "message"@en ;
.

sh:minCount
    schema:description "Specifies the minimum number of values in the set of value nodes."@en ;
    schema:name "min count"@en ;
.

sh:nodeKind
    schema:description "Specifies the node kind (e.g. IRI or literal) each value node."@en ;
    schema:name "node kind"@en ;
.

sh:path
    schema:description "Specifies the property path of a property shape."@en ;
    schema:name "path"@en ;
.

sh:pattern
    schema:description "Specifies a regular expression pattern that the string representations of the value nodes must match."@en ;
    schema:name "pattern"@en ;
.

sh:property
    schema:description "Links a shape to its property shapes."@en ;
    schema:name "property"@en ;
.

sh:select
    schema:description "The SPARQL SELECT query to execute."@en ;
    schema:name "select"@en ;
.

sh:sparql
    schema:description "Links a shape with SPARQL constraints."@en ;
    schema:name "constraint (in SPARQL)"@en ;
.

sh:targetClass
    schema:description "Links a shape to a class, indicating that all instances of the class must conform to the shape."@en ;
    schema:name "target class"@en ;
.

sh:targetObjectsOf
    schema:description "Links a shape to a property, indicating that all all objects of triples that have the given property as their predicate must conform to the shape."@en ;
    schema:name "target objects of"@en ;
.

sh:targetSubjectsOf
    schema:description "Links a shape to a property, indicating that all subjects of triples that have the given property as their predicate must conform to the shape."@en ;
    schema:name "target subjects of"@en ;
.

prez:Manifest
    schema:description "An RDF file that describes and links to a set of resources that can be loaded into an RDF database for the Prez system to provide access to" ;
    schema:name "Manifest" ;
.

<https://prez.dev/ManifestResourceRoles/CatalogueData>
    schema:description "Data for the container, usually a Catalogue, including the identity of it and each item fo content" ;
    schema:name "Catalogue Data" ;
.

<https://prez.dev/ManifestResourceRoles/IncompleteCatalogueAndResourceLabels>
    schema:description "Some of the labels - possibly including names, descriptions & seeAlso links - for the Catalogue and Resource objects" ;
    schema:name "Incomplete Catalogue and Resource Labels" ;
.

<https://prez.dev/ManifestResourceRoles/ResourceData>
    schema:description "Data for the content of the container" ;
    schema:name "Resource Data" ;
.

schema:GeoCoordinates
    schema:description "The geographic coordinates of a place or event." ;
    schema:name "GeoCoordinates" ;
.

schema:GeoShape
    schema:description "The geographic shape of a place. A GeoShape can be described using several properties whose values are based on latitude/longitude pairs. Either whitespace or commas can be used to separate latitude and longitude; whitespace should be used when writing a list of several such points." ;
    schema:name "GeoShape" ;
.

schema:GeospatialGeometry
    schema:description "(Eventually to be defined as) a supertype of GeoShape designed to accommodate definitions from Geo-Spatial best practices." ;
    schema:name "GeospatialGeometry" ;
.

schema:Landform
    schema:description "A landform or physical feature.  Landform elements include mountains, plains, lakes, rivers, seascape and oceanic waterbody interface features such as bays, peninsulas, seas and so forth, including sub-aqueous terrain features such as submersed mountain ranges, volcanoes, and the great ocean basins." ;
    schema:name "Landform" ;
.

schema:Organization
    schema:description "An organization such as a school, NGO, corporation, club, etc." ;
    schema:name "Organization" ;
.

schema:Person
    schema:description "A person (alive, dead, undead, or fictional)." ;
    schema:name "Person" ;
.

schema:affiliation
    schema:description "An organization that this person is affiliated with. For example, a school/university, a club, or a team." ;
    schema:name "affiliation" ;
.

schema:citation
    schema:description "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc." ;
    schema:name "citation" ;
.

schema:codeRepository
    schema:description "Link to the repository where the un-compiled, human readable code and related code is located (SVN, GitHub, CodePlex)." ;
    schema:name "codeRepository" ;
.

schema:contentLocation
    schema:description "The location depicted or described in the content. For example, the location in a photograph or painting." ;
    schema:name "contentLocation" ;
.

schema:contributor
    schema:description "A secondary contributor to the CreativeWork or Event." ;
    schema:name "contributor" ;
.

schema:copyrightHolder
    schema:description "The party holding the legal copyright to the CreativeWork." ;
    schema:name "copyrightHolder" ;
.

schema:copyrightNotice
    schema:description "Text of a notice appropriate for describing the copyright aspects of this Creative Work, ideally indicating the owner of the copyright for the Work." ;
    schema:name "copyrightNotice" ;
.

schema:copyrightYear
    schema:description "The year during which the claimed copyright for the CreativeWork was first asserted." ;
    schema:name "copyrightYear" ;
.

schema:creator
    schema:description "The creator/author of this CreativeWork. This is the same as the Author property for CreativeWork." ;
    schema:name "creator" ;
.

schema:dateCreated
    schema:description "The date on which the CreativeWork was created or the item was added to a DataFeed." ;
    schema:name "dateCreated" ;
.

schema:dateIssued
    schema:description "The date the ticket was issued." ;
    schema:name "dateIssued" ;
.

schema:dateModified
    schema:description "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed." ;
    schema:name "dateModified" ;
.

schema:description
    schema:description "A description of the item." ;
    schema:name "description" ;
.

schema:email
    schema:description "Email address." ;
    schema:name "email" ;
.

schema:geo
    schema:description "The geo coordinates of the place." ;
    schema:name "geo" ;
.

schema:geoCoveredBy
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that covers it. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geoCoveredBy" ;
.

schema:geoCovers
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a covering geometry to a covered geometry. \"Every point of b is a point of (the interior or boundary of) a\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geoCovers" ;
.

schema:geoCrosses
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that crosses it: \"a crosses b: they have some but not all interior points in common, and the dimension of the intersection is less than that of at least one of them\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geoCrosses" ;
.

schema:geoDisjoint
    schema:description "Represents spatial relations in which two geometries (or the places they represent) are topologically disjoint: \"they have no point in common. They form a set of disconnected geometries.\" (A symmetric relationship, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM).)" ;
    schema:name "geoDisjoint" ;
.

schema:geoEquals
    schema:description "Represents spatial relations in which two geometries (or the places they represent) are topologically equal, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM). \"Two geometries are topologically equal if their interiors intersect and no part of the interior or boundary of one geometry intersects the exterior of the other\" (a symmetric relationship)." ;
    schema:name "geoEquals" ;
.

schema:geoIntersects
    schema:description "Represents spatial relations in which two geometries (or the places they represent) have at least one point in common. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geoIntersects" ;
.

schema:geoOverlaps
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that geospatially overlaps it, i.e. they have some but not all points in common. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geoOverlaps" ;
.

schema:geoTouches
    schema:description "Represents spatial relations in which two geometries (or the places they represent) touch: \"they have at least one boundary point in common, but no interior points.\" (A symmetric relationship, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM).)" ;
    schema:name "geoTouches" ;
.

schema:geoWithin
    schema:description "Represents a relationship between two geometries (or the places they represent), relating a geometry to one that contains it, i.e. it is inside (i.e. within) its interior. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    schema:name "geoWithin" ;
.

schema:hasPart
    schema:description
        "Indicates a Resource that is part of this item" ,
        "Indicates an item or CreativeWork that is part of this item, or CreativeWork (in some sense)." ;
    schema:name
        "hasPart" ,
        "member" ;
.

schema:license
    schema:description "A license document that applies to this content, typically indicated by URL." ;
    schema:name "license" ;
.

schema:mainEntity
    schema:description "Indicates the primary entity described in some page or other CreativeWork." ;
    schema:name "mainEntity" ;
.

schema:name
    schema:description
        "The name of the item" ,
        "The name of the item." ;
    schema:name "name" ;
.

schema:parentOrganization
    schema:description "The larger organization that this organization is a [[subOrganization]] of, if any." ;
    schema:name "parentOrganization" ;
.

schema:publisher
    schema:description "The publisher of the creative work." ;
    schema:name "publisher" ;
.

schema:url
    schema:description "URL of the item." ;
    schema:name "url" ;
.

schema:version
    schema:description "The version of the CreativeWork embodied by a specified resource." ;
    schema:name "version" ;
.
